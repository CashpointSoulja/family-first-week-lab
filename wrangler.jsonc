{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-first-week-lab",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "VISITOR", "class_name": "VisitorLab" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VisitorLab"] }],
  "workers_dev": true,
  "preview_urls": false
}
