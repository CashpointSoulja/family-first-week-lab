{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker: fits the Workers Free plan (no bindings, no paid features).
  "name": "family-first-week-lab",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": false
}
