{
  "name": "family-first-week-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Lilli Family First-Week Lab: independent product concept by Ayo Ahmed (not affiliated with Intelligent Lilli). Synthetic data only.",
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "wrangler types src/worker/worker-configuration.d.ts > /dev/null && tsc --noEmit && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:api": "vite build && vitest run -c vitest.api.config.ts",
    "eval": "vite-node eval/consent-eval.ts",
    "eval:broken": "EVAL_RULES=broken EVAL_EXPECT=red vite-node eval/consent-eval.ts",
    "e2e": "playwright test",
    "cf:dev": "wrangler dev",
    "cf:types": "wrangler types src/worker/worker-configuration.d.ts",
    "cf:dryrun": "npm run build && wrangler deploy --dry-run --outdir .wrangler-dryrun",
    "audit:publish": "node scripts/publish-audit.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/epilogue": "^5.3.0",
    "@fontsource/oooh-baby": "^5.3.0",
    "@playwright/test": "^1.47.2",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^4.150.0"
  }
}
